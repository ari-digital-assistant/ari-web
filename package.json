{
  "name": "ari-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "site",
    "docs",
    "functions/report",
    "functions/bugreport",
    "functions/contrib",
    "functions/tester"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "build": "npm run build --workspace site && npm run build --workspace docs",
    "assemble": "node scripts/assemble.mjs",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
