<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Open-source · On-device · Yours</span>
      <h1 style="margin-top:16px">The assistant that <span class="grad">never phones home.</span></h1>
      <p class="lead">Ari hears you, understands you, and answers — right on your device. Open-source, extensible, and it speaks more than one language. No account. No data broker. No catch.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/tester">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 3h5M10.5 3v6.2L5.3 18a2 2 0 0 0 1.7 3h10a2 2 0 0 0 1.7-3l-5.2-8.8V3"/><path d="M8 14.5h8"/></svg>
          Become a tester
        </a>
        <a class="btn btn-ghost" href="https://github.com/ari-digital-assistant">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5l3.09 6.26L22 7.77l-5 4.87 1.18 6.88L12 16.27 5.82 19.52 7 12.64 2 7.77l6.91-1.01z"/></svg>
          Star on GitHub
        </a>
        <a class="btn btn-ghost" href="/skills">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          Browse skills
        </a>
      </div>
      <div class="prerelease"><span class="pulse"></span> Pre-release · Android first, desktop &amp; more to come</div>
      <div class="trust">
        <div class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Runs offline</div>
        <div class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="4" y="11" width="16" height="10" rx="2"/></svg> No telemetry</div>
        <div class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg> 100% open-source</div>
      </div>
    </div>
    <div class="phone-stage">
      <div class="phone">
        <div class="screen">
          <video class="demo-vid" muted loop playsinline preload="none"
                 poster="/video/ari-demo-poster.jpg"
                 aria-label="Ari for Android: listening, thinking, and answering on the phone">
            <source src="/video/ari-demo.webm" type="video/webm" />
            <source src="/video/ari-demo.mp4" type="video/mp4" />
          </video>
          <button class="play" aria-label="Play the Ari demo"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* Hero visuals ported verbatim from docs/design-reference/dusk-mockup.html,
     except the right column: the mockup's listening orb lives in
     ListeningOrb.astro now, and the demo recording has the slot. Shared
     .btn/.btn-primary/.btn-ghost and .eyebrow/.wrap live in global.css. The
     pulse animation is gated by the prefers-reduced-motion guard already in
     global.css — no competing rules here. */
  .hero{position:relative; padding:76px 0 40px; overflow:hidden}
  .hero-grid{display:grid; grid-template-columns:1.05fr .95fr; gap:48px; align-items:center}
  .hero h1{font-size:clamp(40px,6vw,68px); line-height:1.02}
  .hero h1 .grad{
    background:var(--sunset); -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero .lead{margin-top:22px; font-size:clamp(17px,2vw,20px); color:var(--muted); max-width:34ch; font-weight:450}
  .hero .cta-row{display:flex; gap:14px; margin-top:30px; flex-wrap:wrap}
  .hero .prerelease{
    margin-top:18px; font-family:var(--mono); font-size:12.5px; color:var(--muted); letter-spacing:.02em;
    display:flex; align-items:center; gap:9px;
  }
  .pulse{width:8px; height:8px; border-radius:50%; background:var(--flame); box-shadow:0 0 0 0 var(--glow); animation:pulse 2.4s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 var(--glow)}70%{box-shadow:0 0 0 12px transparent}100%{box-shadow:0 0 0 0 transparent}}
  .trust{display:flex; gap:22px; margin-top:34px; flex-wrap:wrap}
  .trust .t{display:flex; align-items:center; gap:9px; font-size:13.5px; font-weight:600; color:var(--ink)}
  .trust .t svg{width:17px; height:17px; color:var(--sun); flex:none}

  /* phone + demo recording */
  .phone-stage{position:relative; display:grid; place-items:center; min-height:380px}
  .phone{position:relative; width:274px; height:560px; border-radius:40px; background:var(--plum-ink);
    padding:11px; box-shadow:0 40px 90px -40px rgba(74,35,64,.7), var(--shadow)}
  .phone .screen{position:relative; width:100%; height:100%; border-radius:30px; overflow:hidden;
    background:linear-gradient(180deg, color-mix(in srgb,var(--plum-ink) 82%, var(--flame)) 0%, var(--plum-ink) 60%); display:grid; place-items:center}
  /* The recording's own aspect (90:197) is a hair narrower than the screen
     cutout, so `cover` trims a sliver off the top and bottom rather than
     letterboxing the sides — the phone chrome stays filled either way. */
  .demo-vid{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block}
  .play{position:absolute; z-index:2; width:66px; height:66px; border-radius:50%; display:grid; place-items:center;
    background:var(--sunset); box-shadow:0 0 40px -4px var(--glow); cursor:pointer; border:none; transition:transform .18s, opacity .18s}
  .play:hover{transform:scale(1.06)}
  .play svg{width:26px; height:26px; color:#fff; margin-left:3px}
  /* Playing means the poster is gone and the button has nothing left to offer. */
  .screen.playing .play{opacity:0; pointer-events:none}

  /* Three buttons stop fitting on one line well before the layout collapses,
     and wrapping leaves them ragged at whatever width their labels happen to
     be. On a grid they share the row evenly instead — two across, or one when
     even that would squeeze a label onto two lines — with the primary always
     spanning the full width above them. */
  @media (max-width:560px){
    .hero .cta-row{display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
    .hero .cta-row .btn{justify-content:center}
    .hero .cta-row .btn:first-child{grid-column:1/-1}
  }

  @media (max-width:860px){
    .hero-grid{grid-template-columns:1fr; gap:8px}
    /* No order swap: on a narrow screen the headline earns the top of the
       page and the recording reads as the payoff underneath it. */
    .phone-stage{min-height:0; margin-top:36px}
  }
</style>
<script>
  // The recording is several megabytes, so it carries preload="none" and only
  // starts once the hero is actually on screen — which on most desktop loads is
  // immediately, but a visitor landing deep-linked further down never pays for
  // it. Reduced-motion visitors get the poster and the play button, which is
  // the same button everyone else gets if autoplay is refused (muted inline
  // autoplay is widely allowed, but not guaranteed).
  const video = document.querySelector('.demo-vid');
  const screen = video?.closest('.screen');
  const playBtn = screen?.querySelector('.play');

  if (video && screen && playBtn) {
    const start = () => video.play().catch(() => { /* leave the button showing */ });

    video.addEventListener('playing', () => screen.classList.add('playing'));
    video.addEventListener('pause', () => screen.classList.remove('playing'));
    playBtn.addEventListener('click', start);

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) start();
          // Pausing off-screen keeps a three-minute loop from decoding into an
          // empty room for as long as the tab is open.
          else if (!video.paused) video.pause();
        }
      }, { threshold: 0.25 });
      io.observe(screen);
    }
  }
</script>
