---
import Logo from './Logo.astro';
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Open-source · On-device · Yours</span>
      <h1 style="margin-top:16px">The assistant that <span class="grad">never phones home.</span></h1>
      <p class="lead">Ari hears you, understands you, and answers — right on your device. Open-source, extensible, and it speaks more than one language. No account. No data broker. No catch.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="https://github.com/ari-digital-assistant">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5l3.09 6.26L22 7.77l-5 4.87 1.18 6.88L12 16.27 5.82 19.52 7 12.64 2 7.77l6.91-1.01z"/></svg>
          Star on GitHub
        </a>
        <a class="btn btn-ghost" href="/skills">Browse skills →</a>
      </div>
      <div class="prerelease"><span class="pulse"></span> Pre-release · Android first, desktop &amp; more to come</div>
      <div class="trust">
        <div class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Runs offline</div>
        <div class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="4" y="11" width="16" height="10" rx="2"/></svg> No telemetry</div>
        <div class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg> 100% open-source</div>
      </div>
    </div>
    <div class="orb-stage" aria-hidden="true">
      <div class="field"></div>
      <div class="orb">
        <div class="ring"></div>
        <Logo size={118} />
        <div class="wave"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="orb-cap">“Hey Ari” · listening</div>
      </div>
    </div>
  </div>
</section>
<style>
  /* Hero visuals ported verbatim from docs/design-reference/dusk-mockup.html.
     Shared .btn/.btn-primary/.btn-ghost and .eyebrow/.wrap live in global.css.
     Animations (pulse/breathe/eq) are gated by the prefers-reduced-motion
     guard already in global.css — no competing rules here. */
  .hero{position:relative; padding:76px 0 40px; overflow:hidden}
  .hero-grid{display:grid; grid-template-columns:1.05fr .95fr; gap:48px; align-items:center}
  .hero h1{font-size:clamp(40px,6vw,68px); line-height:1.02}
  .hero h1 .grad{
    background:var(--sunset); -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero .lead{margin-top:22px; font-size:clamp(17px,2vw,20px); color:var(--muted); max-width:34ch; font-weight:450}
  .hero .cta-row{display:flex; gap:14px; margin-top:30px; flex-wrap:wrap}
  .hero .prerelease{
    margin-top:18px; font-family:var(--mono); font-size:12.5px; color:var(--muted); letter-spacing:.02em;
    display:flex; align-items:center; gap:9px;
  }
  .pulse{width:8px; height:8px; border-radius:50%; background:var(--flame); box-shadow:0 0 0 0 var(--glow); animation:pulse 2.4s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 var(--glow)}70%{box-shadow:0 0 0 12px transparent}100%{box-shadow:0 0 0 0 transparent}}
  .trust{display:flex; gap:22px; margin-top:34px; flex-wrap:wrap}
  .trust .t{display:flex; align-items:center; gap:9px; font-size:13.5px; font-weight:600; color:var(--ink)}
  .trust .t svg{width:17px; height:17px; color:var(--sun); flex:none}

  /* listening orb */
  .orb-stage{position:relative; display:grid; place-items:center; min-height:380px}
  .field{
    position:absolute; width:440px; height:440px; border-radius:50%;
    background:radial-gradient(circle at 50% 45%, var(--glow), var(--glow-2) 42%, transparent 66%);
    filter:blur(6px); animation:breathe 6s ease-in-out infinite;
  }
  @keyframes breathe{0%,100%{transform:scale(.94); opacity:.85}50%{transform:scale(1.06); opacity:1}}
  .orb{
    position:relative; width:236px; height:236px; border-radius:50%;
    background:
      radial-gradient(circle at 50% 38%, color-mix(in srgb,var(--surface) 82%, var(--amber)) 0%, var(--surface) 60%),
      var(--surface);
    border:1px solid var(--hair);
    box-shadow:var(--shadow), 0 0 60px -6px var(--glow);
    display:grid; place-items:center;
  }
  .orb :global(.mark){width:118px; height:118px; filter:drop-shadow(0 8px 22px var(--glow))}
  .orb .ring{position:absolute; inset:-1px; border-radius:50%; border:1.5px solid transparent;
    background:var(--sunset) border-box; -webkit-mask:linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor; mask-composite:exclude; opacity:.55}
  .wave{position:absolute; bottom:44px; display:flex; gap:5px; align-items:flex-end; height:26px}
  .wave span{width:4px; border-radius:3px; background:var(--sunset); animation:eq 1.1s ease-in-out infinite}
  .wave span:nth-child(1){height:40%; animation-delay:0s}
  .wave span:nth-child(2){height:80%; animation-delay:.12s}
  .wave span:nth-child(3){height:55%; animation-delay:.24s}
  .wave span:nth-child(4){height:100%; animation-delay:.36s}
  .wave span:nth-child(5){height:65%; animation-delay:.48s}
  .wave span:nth-child(6){height:35%; animation-delay:.6s}
  @keyframes eq{0%,100%{transform:scaleY(.4)}50%{transform:scaleY(1)}}
  .orb-cap{position:absolute; bottom:12px; font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted)}

  @media (max-width:860px){
    .hero-grid{grid-template-columns:1fr; gap:8px}
    .orb-stage{min-height:320px; order:-1}
  }
</style>
