---
import Logo from './Logo.astro';
import FriendlyBadge from './FriendlyBadge.astro';
---
<footer>
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="brand" href="/"><Logo /><span>Ari</span></a>
      <p>An open-source digital assistant that keeps your voice, your data and your home to yourself.</p>
    </div>
    <div class="foot-cols">
      <div class="foot-col"><h4>Product</h4>
        <a href="/#features">Features</a><a href="/privacy">Privacy</a><a href="/skills">Skills</a>
      </div>
      <div class="foot-col"><h4>Docs</h4>
        <a href="/docs">Using Ari</a><a href="/docs">Write a skill</a>
      </div>
      <div class="foot-col"><h4>Open source</h4>
        <a href="https://github.com/ari-digital-assistant">GitHub org</a>
        <a href="https://github.com/ari-digital-assistant/ari-skills">ari-skills</a>
      </div>
    </div>
  </div>
  <div class="wrap foot-legal">
    <span class="licences">
      <a href="https://github.com/ari-digital-assistant/ari-android/blob/HEAD/LICENSE">Ari GPL-3.0</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="https://github.com/ari-digital-assistant/ari-web/blob/HEAD/LICENSE">Site MIT</a>
    </span>
    <FriendlyBadge />
    <span>heyari.dev</span>
  </div>
</footer>
<style>
  /* .foot-* rules ported verbatim from docs/design-reference/dusk-mockup.html. */
  footer{border-top:1px solid var(--hair); padding:48px 0 40px; color:var(--muted); margin-top:64px}
  .foot-grid{display:flex; justify-content:space-between; gap:40px; flex-wrap:wrap}
  .foot-brand{max-width:30ch}
  .foot-brand .brand{color:var(--ink); margin-bottom:12px}
  .foot-brand p{font-size:13.5px}
  .foot-cols{display:flex; gap:56px; flex-wrap:wrap}
  .foot-col h4{font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink); margin:0 0 14px}
  .foot-col a{display:block; font-size:14px; margin-bottom:9px; transition:color .15s}
  .foot-col a:hover{color:var(--sun)}
  /* 1fr auto 1fr rather than space-between: the badge sits on the page's centre
     line instead of wherever two unequal runs of text happen to leave it. */
  .foot-legal{margin-top:36px; padding-top:22px; border-top:1px solid var(--hair); font-family:var(--mono); font-size:12px;
    display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:16px}
  .foot-legal > :last-child{justify-self:end}
  /* The engine, the apps and the site are not under the same licence, and the
     difference matters to anyone thinking of reusing either. Both link to the
     text; HEAD rather than main so a default-branch rename cannot 404 them. */
  /* The separator carries its own margins rather than leaning on a bare "·"
     between two tags (the HTML minifier collapses that whitespace away) or on
     the parent's flex gap (which silently buys nothing if the parent ever
     stops being a flex container). Margins on the element work either way. */
  .licences{display:flex; align-items:center; flex-wrap:wrap}
  .licences .sep{margin:0 .5em; opacity:.45}
  .licences a{transition:color .15s}
  .licences a:hover{color:var(--sun); text-decoration:underline; text-underline-offset:3px}
  @media (max-width:560px){
    .foot-grid{gap:28px}
    .foot-legal{grid-template-columns:1fr; justify-items:center; text-align:center; gap:20px}
    .foot-legal > :last-child{justify-self:center}
  }
</style>
