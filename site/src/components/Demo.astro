---
import Logo from './Logo.astro';
---
<section class="demo" id="demo">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">See it in action</span>
      <h2>Watch Ari do its thing.</h2>
      <p>A quick look at Ari listening, thinking, and answering — all on the phone, no cloud round-trip. Yes, it really is this quick.</p>
    </div>
    <div class="demo-tabs" role="tablist" aria-label="Platform">
      <button class="demo-tab" role="tab" aria-selected="true" data-pane="android">Android</button>
      <button class="demo-tab" role="tab" aria-selected="false" data-pane="linux">Linux <span class="soon">Soon</span></button>
    </div>
    <div class="stage">
      <div class="pane on" data-pane="android">
        <div class="phone">
          <div class="notch"></div>
          <div class="screen">
            <div class="vid-placeholder">
              <span class="cap">Ari for Android</span>
              <button class="play" aria-label="Play demo (placeholder)"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
              <div class="big">Looping demo</div>
              <div class="mini-wave"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
              <span class="cap">Video coming soon</span>
            </div>
          </div>
        </div>
      </div>
      <div class="pane" data-pane="linux">
        <div class="desktop">
          <div class="bar"><i></i><i></i><i></i></div>
          <div class="body">
            <div class="soon-block">
              <Logo size={56} />
              <div class="big">Ari for Linux</div>
              <p>A proper Linux desktop app is on the workbench — libadwaita, built for GNOME. Same engine, same skills, same "stays on your machine" promise.</p>
              <span class="soon-pill">Coming soon</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* Demo visuals ported verbatim from docs/design-reference/dusk-mockup.html's
     <section class="demo">. Shared .eyebrow/.wrap/.sec-head + section padding
     live in global.css. The soon-block mark is the <Logo> component, reached
     with :global(.mark) exactly as Hero does. The eq keyframe is duplicated
     here because Astro scopes keyframes per component. Animations are gated by
     the prefers-reduced-motion guard already in global.css. */
  .demo{padding-top:64px}
  .demo-tabs{display:inline-flex; gap:5px; padding:5px; border-radius:14px; background:var(--surface-2); border:1px solid var(--hair); margin-top:26px}
  .demo-tab{
    display:flex; align-items:center; gap:8px; font-weight:700; font-size:14px; color:var(--muted);
    padding:9px 16px; border-radius:10px; cursor:pointer; border:none; background:transparent; transition:all .16s;
  }
  .demo-tab svg{width:16px; height:16px}
  .demo-tab[aria-selected="true"]{background:var(--surface); color:var(--ink); box-shadow:var(--shadow)}
  .demo-tab .soon{font-family:var(--mono); font-size:9.5px; letter-spacing:.08em; text-transform:uppercase; color:#fff; background:var(--plum); padding:2px 6px; border-radius:5px}
  .stage{margin-top:34px; display:grid; place-items:center; padding:44px 20px; border-radius:24px;
    background:radial-gradient(120% 120% at 50% 0%, var(--surface) 0%, var(--bg) 70%); border:1px solid var(--hair); position:relative; overflow:hidden}
  .stage::before{content:""; position:absolute; top:-40%; left:50%; transform:translateX(-50%); width:520px; height:520px; border-radius:50%;
    background:radial-gradient(circle, var(--glow), transparent 62%); opacity:.7}
  .pane{display:none} .pane.on{display:block}
  /* phone frame */
  .phone{position:relative; width:274px; height:560px; border-radius:40px; background:var(--plum-ink);
    padding:11px; box-shadow:0 40px 90px -40px rgba(74,35,64,.7), var(--shadow); z-index:1}
  .phone .screen{position:relative; width:100%; height:100%; border-radius:30px; overflow:hidden;
    background:linear-gradient(180deg, color-mix(in srgb,var(--plum-ink) 82%, var(--flame)) 0%, var(--plum-ink) 60%); display:grid; place-items:center}
  .phone .notch{position:absolute; top:10px; left:50%; transform:translateX(-50%); width:96px; height:22px; border-radius:12px; background:rgba(0,0,0,.55); z-index:3}
  .vid-placeholder{display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center; padding:0 24px; color:#F6EDE1}
  .play{width:66px; height:66px; border-radius:50%; display:grid; place-items:center; background:var(--sunset); box-shadow:0 0 40px -4px var(--glow); cursor:pointer; transition:transform .18s}
  .play:hover{transform:scale(1.06)}
  .play svg{width:26px; height:26px; color:#fff; margin-left:3px}
  .vid-placeholder .cap{font-family:var(--mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:#D9C3D0}
  .vid-placeholder .big{font-weight:800; font-size:18px; letter-spacing:-.02em}
  .mini-wave{display:flex; gap:4px; align-items:flex-end; height:20px}
  .mini-wave span{width:3px; border-radius:2px; background:var(--amber); animation:eq 1.1s ease-in-out infinite}
  .mini-wave span:nth-child(odd){height:60%} .mini-wave span:nth-child(even){height:100%}
  .mini-wave span:nth-child(3n){animation-delay:.2s} .mini-wave span:nth-child(3n+1){animation-delay:.4s}
  @keyframes eq{0%,100%{transform:scaleY(.4)}50%{transform:scaleY(1)}}
  /* desktop frame */
  .desktop{position:relative; width:min(620px,100%); border-radius:16px; overflow:hidden; background:var(--surface); border:1px solid var(--hair); box-shadow:0 40px 90px -46px rgba(74,35,64,.7); z-index:1}
  .desktop .bar{display:flex; align-items:center; gap:7px; padding:12px 16px; border-bottom:1px solid var(--hair); background:var(--surface-2)}
  .desktop .bar i{width:11px; height:11px; border-radius:50%; background:var(--hair)}
  .desktop .bar i:first-child{background:var(--flame)}
  .desktop .body{aspect-ratio:16/10; display:grid; place-items:center;
    background:linear-gradient(160deg, color-mix(in srgb,var(--surface) 70%, var(--amber)) 0%, var(--surface) 60%)}
  .soon-block{text-align:center; display:flex; flex-direction:column; align-items:center; gap:14px; color:var(--ink)}
  .soon-block :global(.mark){width:56px; height:56px; opacity:.9; filter:drop-shadow(0 6px 16px var(--glow))}
  .soon-block .big{font-weight:800; font-size:22px; letter-spacing:-.02em}
  .soon-block p{color:var(--muted); font-size:14px; max-width:34ch}
  .soon-pill{font-family:var(--mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#fff; background:var(--plum); padding:6px 12px; border-radius:999px}
</style>
<script>
  document.querySelector('.demo-tabs')?.addEventListener('click', (e) => {
    const t = e.target.closest('.demo-tab'); if (!t) return;
    document.querySelectorAll('.demo-tab').forEach(b => b.setAttribute('aria-selected', String(b === t)));
    document.querySelectorAll('.pane').forEach(p => p.classList.toggle('on', p.dataset.pane === t.dataset.pane));
  });
</script>
