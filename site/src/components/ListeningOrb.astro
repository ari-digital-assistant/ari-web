---
import Logo from './Logo.astro';
---
<div class="orb-stage" aria-hidden="true">
  <div class="field"></div>
  <div class="orb">
    <div class="ring"></div>
    <Logo size={118} />
    <div class="wave"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="orb-cap">“Hey Ari” · listening</div>
  </div>
</div>
<style>
  /* Lifted out of Hero when the demo recording took the hero's right column.
     Kept whole — it is the only piece of Ari-specific art the site owns, and
     the mockup it came from (docs/design-reference/dusk-mockup.html) is not a
     living document. Animations are gated by the prefers-reduced-motion guard
     already in global.css. */
  .orb-stage{position:relative; display:grid; place-items:center; min-height:380px}
  .field{
    position:absolute; width:440px; height:440px; border-radius:50%;
    background:radial-gradient(circle at 50% 45%, var(--glow), var(--glow-2) 42%, transparent 66%);
    filter:blur(6px); animation:breathe 6s ease-in-out infinite;
  }
  @keyframes breathe{0%,100%{transform:scale(.94); opacity:.85}50%{transform:scale(1.06); opacity:1}}
  .orb{
    position:relative; width:236px; height:236px; border-radius:50%;
    background:
      radial-gradient(circle at 50% 38%, color-mix(in srgb,var(--surface) 82%, var(--amber)) 0%, var(--surface) 60%),
      var(--surface);
    border:1px solid var(--hair);
    box-shadow:var(--shadow), 0 0 60px -6px var(--glow);
    display:grid; place-items:center;
  }
  .orb :global(.mark){width:118px; height:118px; filter:drop-shadow(0 8px 22px var(--glow))}
  .orb .ring{position:absolute; inset:-1px; border-radius:50%; border:1.5px solid transparent;
    background:var(--sunset) border-box; -webkit-mask:linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor; mask-composite:exclude; opacity:.55}
  .wave{position:absolute; bottom:44px; display:flex; gap:5px; align-items:flex-end; height:26px}
  .wave span{width:4px; border-radius:3px; background:var(--sunset); animation:eq 1.1s ease-in-out infinite}
  .wave span:nth-child(1){height:40%; animation-delay:0s}
  .wave span:nth-child(2){height:80%; animation-delay:.12s}
  .wave span:nth-child(3){height:55%; animation-delay:.24s}
  .wave span:nth-child(4){height:100%; animation-delay:.36s}
  .wave span:nth-child(5){height:65%; animation-delay:.48s}
  .wave span:nth-child(6){height:35%; animation-delay:.6s}
  @keyframes eq{0%,100%{transform:scaleY(.4)}50%{transform:scaleY(1)}}
  .orb-cap{position:absolute; bottom:12px; font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted)}

  @media (max-width:860px){
    .orb-stage{min-height:320px}
  }
</style>
