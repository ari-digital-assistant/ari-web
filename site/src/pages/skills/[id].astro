---
import Base from '../../layouts/Base.astro';
import SkillDetail from '../../components/SkillDetail.astro';
import { registrySkills } from '../../lib/registry.js';
import { niceName, metaDescription, screenshotPlatforms } from '../../lib/skills.js';

// One real page per skill in the registry at build time. Before this, every
// /skills/<id> was the same client-rendered template, so crawlers and social
// unfurls saw a generic "Skill — Ari" title and no content at all.
export async function getStaticPaths() {
  const skills = await registrySkills();
  return skills.map((skill) => ({ params: { id: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;
const title = `${niceName(skill.name)} — Ari skill`;
const description = metaDescription(skill);
// The unfurl card is built per skill by /og/skills/[id].jpg.js: its first
// screenshot in a phone on the brand background. A skill with no screenshots
// gets no card of its own and unfurls with the site's.
const card = screenshotPlatforms(skill).length
  ? { image: `/og/skills/${skill.id}.jpg`, imageWidth: 1200, imageHeight: 630, imageAlt: `${niceName(skill.name)}, a skill for Ari, running on a phone` }
  : {};
---
<Base title={title} description={description} {...card}>
  <SkillDetail skill={skill} />
</Base>
